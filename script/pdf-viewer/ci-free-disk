#!/usr/bin/env bash
# Frees disk space on GitHub's macOS runners, which ship with SDKs a Zed build
# doesn't need. Building Zed needs roughly 20 GB of free space.
set -euo pipefail

if [[ "${CI:-}" != "true" ]]; then
    echo "ci-free-disk: refusing to delete SDKs outside CI" >&2
    exit 1
fi

# Runners start with about 40 GB free, which covers the first minutes of a build.
# Deleting takes several minutes, so it runs in the background while the build
# starts instead of holding up the job. The runner keeps it alive until the job ends.
df -h /
paths=(
    "${HOME}/Library/Android"
    /usr/local/share/dotnet
    /usr/local/lib/node_modules
    "${HOME}/.dotnet"
    "${HOME}/hostedtoolcache/CodeQL"
)
active_xcode="$(xcode-select -p | sed 's|/Contents/Developer||')"
for xcode in /Applications/Xcode*.app; do
    if [[ "${xcode}" != "${active_xcode}" ]]; then
        paths+=("${xcode}")
    fi
done
nohup sudo rm -rf "${paths[@]}" >/dev/null 2>&1 &
nohup xcrun simctl delete all >/dev/null 2>&1 &
echo "ci-free-disk: deleting ${#paths[@]} unused SDK folders in the background"
